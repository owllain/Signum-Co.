---
// CapabilitiesStrip — Chunked Two-Pillar Executive Architecture (Miller's Law + Hick's Law)
import type { SiteContent } from '../../data/site';
import { routes } from '../../data/experience';
import { FounderQuote } from '../interactive/FlowbitePrimitives';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const es = content.locale === 'es';
const r = routes[content.locale];

const pillars = es
  ? [
      {
        code: 'PILAR 01 · INTELIGENCIA Y DATOS',
        lead: 'Kevin Arroyo',
        title: 'Datos confiables para decidir',
        subtitle:
          'Indicadores conciliados y visibilidad comercial en tiempo real.',
        ctaLabel: 'Explorar Datos y Analítica',
        ctaHref: r.enterprise,
        items: [
          {
            title: 'Dashboards en Dataverse, Power BI y Tableau',
            description:
              'Tableros ejecutivos con KPIs conciliados para dirección, finanzas y ventas.',
          },
          {
            title: 'Fuentes unificadas en la nube',
            description:
              'Consolidamos ERP, CRM y hojas de cálculo en Snowflake, BigQuery o SQL.',
          },
          {
            title: 'Atribución comercial y modelos predictivos',
            description:
              'Medición GA4/GTM de embudos y proyecciones de demanda en Python.',
          },
        ],
      },
      {
        code: 'PILAR 02 · INGENIERÍA Y OPERACIÓN',
        lead: 'Enrique Cascante',
        title: 'Software y automatización sin fricción',
        subtitle:
          'Sistemas a medida y flujos automáticos que eliminan trabajo manual.',
        ctaLabel: 'Explorar Desarrollo y Automatización',
        ctaHref: r.development,
        items: [
          {
            title: 'Aplicaciones a medida en .NET, React y SQL',
            description:
              'Sistemas internos, expedientes digitales y portales con roles y auditoría.',
          },
          {
            title: 'Microsoft 365, Power Platform y bots RPA',
            description:
              'Flujos con Power Automate, bots RPA Desktop, Power Apps y SharePoint SPFx.',
          },
          {
            title: 'Integraciones y portales B2B',
            description:
              'Conexión bidireccional entre CRM/ERP y plataformas web de alto rendimiento.',
          },
        ],
      },
    ]
  : [
      {
        code: 'PILLAR 01 · DATA & INTELLIGENCE',
        lead: 'Kevin Arroyo',
        title: 'Trusted data for decisions',
        subtitle:
          'Reconciled KPIs and real-time commercial visibility.',
        ctaLabel: 'Explore Data & Analytics',
        ctaHref: r.enterprise,
        items: [
          {
            title: 'Dataverse, Power BI & Tableau dashboards',
            description:
              'Executive dashboards with reconciled KPIs for leadership, finance, and sales.',
          },
          {
            title: 'Unified cloud data sources',
            description:
              'Consolidate ERP, CRM, and spreadsheets into Snowflake, BigQuery, or SQL.',
          },
          {
            title: 'Revenue attribution & predictive models',
            description:
              'GA4/GTM funnel tracking and demand forecasting models in Python.',
          },
        ],
      },
      {
        code: 'PILLAR 02 · ENGINEERING & OPERATIONS',
        lead: 'Enrique Cascante',
        title: 'Frictionless software and automation',
        subtitle:
          'Custom systems and automated workflows that eliminate manual work.',
        ctaLabel: 'Explore Development & Automation',
        ctaHref: r.development,
        items: [
          {
            title: 'Custom .NET, React & SQL applications',
            description:
              'Internal systems, digital case files, and portals with role-based permissions.',
          },
          {
            title: 'Microsoft 365, Power Platform & RPA bots',
            description:
              'Power Automate workflows, Desktop RPA bots, Power Apps, and SharePoint SPFx.',
          },
          {
            title: 'System integrations & B2B portals',
            description:
              'Two-way bridges across CRM/ERP and high-speed corporate web platforms.',
          },
        ],
      },
    ];
---

<section class="sec saas-cap-section" aria-labelledby="cap-strip-heading">
  <div class="wrap">
    <div class="saas-cap-header">
      <span class="section-label">
        {es ? 'Dos disciplinas · Una arquitectura' : 'Two disciplines · One architecture'}
      </span>
      <h2 id="cap-strip-heading">
        {
          es
            ? '¿Qué necesita resolver hoy?'
            : 'What do you need to solve today?'
        }
      </h2>
    </div>

    <!-- 2-Pillar Executive Bifurcation (Miller's Law + Hick's Law) -->
    <div class="saas-pillars-grid">
      {
        pillars.map((pillar) => (
          <article class="saas-pillar-card">
            <header class="saas-pillar-top">
              <div class="saas-pillar-meta">
                <span class="saas-pillar-code">{pillar.code}</span>
                <span class="saas-pillar-owner">{pillar.lead}</span>
              </div>
              <h3>{pillar.title}</h3>
              <p class="saas-pillar-sub">{pillar.subtitle}</p>
            </header>

            <ul class="saas-pillar-list">
              {pillar.items.map((item, idx) => (
                <li>
                  <span class="saas-feature-num">0{idx + 1}</span>
                  <div>
                    <h4>{item.title}</h4>
                    <p>{item.description}</p>
                  </div>
                </li>
              ))}
            </ul>

            <footer class="saas-pillar-footer">
              <a class="saas-pillar-cta" href={pillar.ctaHref}>
                <span>{pillar.ctaLabel}</span>
                <span aria-hidden="true">→</span>
              </a>
            </footer>
          </article>
        ))
      }
    </div>

    <!-- Flowbite Blockquote + Avatar Founder Quote -->
    <div class="saas-founder-quote-card">
      <FounderQuote
        quote={
          es
            ? 'Construimos activos de datos, software en .NET y automatizaciones en Microsoft 365 que su equipo puede auditar y operar con total autonomía.'
            : 'We build data assets, .NET software, and Microsoft 365 automations that your team can audit and operate with full autonomy.'
        }
        authorName="Kevin Arroyo & Enrique Cascante"
        authorRole={
          es
            ? 'Socios · 100% transferencia de código y modelos'
            : 'Partners · 100% transfer of code and models'
        }
        avatarImg="/images/avatar-kevin.webp"
      />
    </div>
  </div>
</section>

<style>
  .saas-cap-section {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .saas-cap-header {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .saas-cap-header h2 {
    max-width: 24ch;
  }

  .saas-cap-lead {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 58ch;
  }

  .saas-pillars-grid {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .saas-pillar-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    border-radius: 16px;
    background: var(--surface-elevated);
    border: 1px solid var(--line-strong);
    box-shadow: var(--card-shadow);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .saas-pillar-card:hover {
    border-color: rgba(201, 162, 39, 0.55);
    box-shadow: var(--card-shadow-hover);
  }

  .saas-pillar-top {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .saas-pillar-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .saas-pillar-code {
    font-family: var(--f-code);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold-ink);
    background: var(--gold-soft);
    padding: 0.28rem 0.6rem;
    border-radius: 6px;
  }

  .saas-pillar-owner {
    font-family: var(--f-code);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .saas-pillar-top h3 {
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    line-height: 1.2;
    color: var(--fg);
    margin-bottom: 0.5rem;
  }

  .saas-pillar-sub {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0;
  }

  .saas-pillar-list {
    list-style: none;
    padding: 1.25rem 0;
    margin: 0;
    display: grid;
    gap: 1.1rem;
  }

  .saas-pillar-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .saas-feature-num {
    font-family: var(--f-code);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gold-ink);
    background: rgba(201, 162, 39, 0.12);
    border: 1px solid rgba(201, 162, 39, 0.3);
    padding: 0.2rem 0.48rem;
    border-radius: 5px;
    margin-top: 0.12rem;
  }

  .saas-pillar-list h4 {
    font-family: var(--f-body);
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--fg);
    margin: 0 0 0.25rem;
  }

  .saas-pillar-list p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--muted);
    margin: 0;
  }

  .saas-pillar-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    margin-top: auto;
  }

  .saas-pillar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--gold-ink);
    text-decoration: none;
    transition: color 150ms ease, gap 150ms ease;
  }

  .saas-pillar-cta:hover {
    color: var(--fg);
    gap: 0.75rem;
  }

  .saas-founder-quote-card {
    margin-top: 2.75rem;
  }

  @media (max-width: 900px) {
    .saas-pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

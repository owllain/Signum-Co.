---
import type { SiteContent } from '../../data/site';
import { routes } from '../../data/experience';
import { developmentServices } from '../../data/services';
import ServiceCatalogExplorer, {
  type ExplorerTab,
} from '../interactive/ServiceCatalogExplorer';

interface Props {
  content: SiteContent;
  initialTab?: ExplorerTab;
  compactMode?: boolean;
}

const { content, initialTab = 'all', compactMode = false } = Astro.props;
const es = content.locale === 'es';
---

<section class="sec" id="especialidades" aria-labelledby="tracks-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <span class="section-label">
          {
            es
              ? 'Catálogo Integral · 13 Soluciones Empresariales'
              : 'Complete Catalog · 13 Enterprise Solutions'
          }
        </span>
        <h2 id="tracks-title">
          {
            es
              ? 'Dos especialidades. Un mismo objetivo.'
              : 'Two disciplines. One shared goal.'
          }
        </h2>
      </div>
    </div>

    <ServiceCatalogExplorer
      client:visible
      locale={content.locale}
      initialTab={initialTab}
      enterpriseRows={content.enterprise.rows}
      growthRows={content.services.rows}
      developmentRows={developmentServices[content.locale]}
      contactUrl={routes[content.locale].contact}
      servicesUrl={routes[content.locale].services}
      compactMode={compactMode}
    />
  </div>
</section>

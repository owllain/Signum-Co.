---
import { experience, routes } from '../../data/experience';
import Arrow from '../ui/Arrow.astro';
import type { SiteContent } from '../../data/site';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const es = content.locale === 'es';

---

<section class="sec" id={content.enterprise.id} aria-labelledby="h-ent">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <span class="section-label">
          {es ? 'Línea Empresarial · Kevin Arroyo' : 'Enterprise Line · Kevin Arroyo'}
        </span>
        <h2 id="h-ent">{content.enterprise.heading}</h2>
      </div>
      <p class="intro">{content.enterprise.intro}</p>
    </div>

    <div class="bento-catalog-grid">
      {
        content.enterprise.rows.map((row, index) => (
          <article class="bento-service-card" id={`enterprise-${index}`}>
            <div class="bento-card-body">
              <h3>{row.title}</h3>
              <p class="bento-desc">{row.description}</p>
              <ul class="bento-deliverables">
                {row.bullets.map((bullet) => (
                  <li>
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <div class="bento-card-footer">
                <span class="bento-owner">Kevin Arroyo</span>
                <a
                  class="bento-cta"
                  data-contact-topic={`enterprise-${index}`}
                  href={`${routes[content.locale].contact}?topic=enterprise-${index}#contacto`}
                >
                  <span>{experience[content.locale].discuss}</span>
                  <Arrow />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

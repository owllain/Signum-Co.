---
import type { SiteContent } from '../../data/site';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="sec" id={content.pricing.id} aria-labelledby="h-price">
  <div class="wrap">
    <div class="split">
      <div class="split-head">
        <h2 id="h-price">{content.pricing.heading}</h2>
        <p class="intro">{content.pricing.intro}</p>
      </div>
      <div class="svc">
        {
          content.pricing.rows.map((row) => (
            <div class="svc-row">
              <h3>{row.title}</h3>
              <p>{row.description}</p>
              <ul>
                {row.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="price-note">{content.pricing.note}</p>
    </div>
  </div>
</section>


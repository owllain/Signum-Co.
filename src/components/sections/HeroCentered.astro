---
// HeroCentered — centered hero with panoramic media below the content.
// Premium style (Relume/Awwwards + astrosaas foundation), light entrance animation (staggered), 3 button types.
import BrandImage from '../ui/BrandImage.astro';
import AcidSquares from '../interactive/AcidSquares';
import type { BrandImageKind } from '../../data/brand-images';
import type { Locale } from '../../data/site';

interface Cta {
  label: string;
  href: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primary?: Cta;
  secondary?: Cta;
  link?: Cta;
  image?: string;
  imageAlt?: string;
  imageKind?: BrandImageKind;
  locale?: Locale;
  bg?: 'white' | 'gray' | 'navy';
  breadcrumbs?: BreadcrumbItem[];
  metrics?: MetricItem[];
  showMedia?: boolean;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  primary,
  secondary,
  link,
  image = '/images/signal-1200.webp',
  imageAlt = '',
  imageKind,
  locale = 'es',
  bg = 'navy',
  breadcrumbs = [],
  metrics = [],
  showMedia = true,
  compact = false,
} = Astro.props;
---

<section
  data-ab-category="Hero"
  class:list={['hc', `hc--${bg}`, compact && 'hc--compact']}
>
  {
    bg === 'navy' && (
      <AcidSquares
        client:load
        color="#091326"
        accentColor="#c9a227"
        secondaryColor="#1c3b70"
        tileSize={1.08}
        gap={0.14}
        roundness={0.24}
        rotation={28}
        waves={compact ? 0.75 : 1}
        pulse={compact ? 0.75 : 1}
        mouseInteraction
        pulseOnClick
        opacity={0.92}
      />
    )
  }

  <div class="wrap hc__container">
    <div class="hc__inner">
      {
        breadcrumbs.length > 0 && (
          <nav
            class="breadcrumbs hc__anim"
            style="--d:0ms"
            aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
          >
            {breadcrumbs.map((crumb, idx) => (
              <>
                { idx > 0 && <span aria-hidden="true">/</span> }
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }

      {
        eyebrow && (
          <span class="eyebrow hc__anim" style="--d:0ms">
            <span class="eyebrow__dot" aria-hidden="true" />
            {eyebrow}
          </span>
        )
      }

      <h1 class="hc__title hc__anim" style="--d:80ms">{title}</h1>

      {
        subtitle && (
          <p class="hc__subtitle hc__anim" style="--d:160ms">
            {subtitle}
          </p>
        )
      }

      {
        (primary || secondary || link) && (
          <div class="hc__actions hc__anim" style="--d:240ms">
            {primary && (
              <a class="btn btn--primary" href={primary.href}>
                {primary.label}
              </a>
            )}
            {secondary && (
              <a class="btn btn--secondary" href={secondary.href}>
                {secondary.label}
              </a>
            )}
            {link && (
              <a class="btn btn--link" href={link.href}>
                <span>{link.label}</span>
                <span class="hc__arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )
      }

      {
        metrics.length > 0 && (
          <ul
            class="hc__metrics hc__anim"
            style="--d:290ms"
            aria-label={locale === 'es' ? 'Indicadores clave' : 'Key indicators'}
          >
            {metrics.map((m) => (
              <li>
                <strong>{m.value}</strong>
                <span>{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      showMedia && (
        <figure class="hc__media hc__anim" style="--d:340ms">
          <div class="hc__media-window">
            <div class="hc__window-bar" aria-hidden="true">
              <div class="hc__window-dots">
                <span />
                <span />
                <span />
              </div>
              <span class="hc__window-title">
                SIGNUM &amp; CO. · ARCHITECTURE &amp; DECISION INTELLIGENCE
              </span>
              <span class="hc__window-status">LIVE TELEMETRY</span>
            </div>
            <div class="hc__media-frame">
              {imageKind ? (
                <BrandImage
                  kind={imageKind}
                  locale={locale}
                  eager
                  showBadge
                  sizes="(max-width: 760px) 100vw, 1080px"
                />
              ) : (
                <img src={image} alt={imageAlt} loading="eager" decoding="async" />
              )}
            </div>
          </div>
        </figure>
      )
    }
  </div>
</section>

<style>
  .hc {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 7vw, 6rem) 0 clamp(2.75rem, 5.5vw, 4.75rem);
    border-bottom: 1px solid var(--line);
  }

  .hc--compact {
    padding: clamp(2.75rem, 5vw, 4.25rem) 0 clamp(2.25rem, 4vw, 3.5rem);
  }

  .hc--white {
    background: var(--surface);
    color: var(--fg);
  }

  .hc--gray {
    background: var(--bg);
    color: var(--fg);
  }

  .hc--navy {
    background: var(--navy);
    color: var(--on-navy);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .hc__container {
    position: relative;
    z-index: 2;
  }

  .hc__inner {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--f-code);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(201, 162, 39, 0.15);
    border: 1px solid rgba(201, 162, 39, 0.42);
    color: var(--gold);
  }

  .hc--white .eyebrow,
  .hc--gray .eyebrow {
    color: var(--gold-ink);
    background: var(--gold-soft);
  }

  .eyebrow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.24);
  }

  .hc__title {
    margin: 1rem 0 0;
    font-family: var(--f-display);
    font-size: clamp(2.25rem, 4.4vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hc--compact .hc__title {
    font-size: clamp(2rem, 3.6vw, 3rem);
  }

  .hc--navy .hc__title {
    color: #ffffff;
  }

  .hc__subtitle {
    margin: 1.15rem 0 0;
    max-width: 58ch;
    font-size: 1.12rem;
    line-height: 1.58;
    color: rgba(33, 32, 28, 0.74);
  }

  .hc--navy .hc__subtitle {
    color: var(--on-navy-muted);
  }

  .hc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.9rem;
  }

  .btn--primary {
    background: var(--gold);
    color: #161209;
    border: 1px solid var(--gold);
    font-weight: 600;
    box-shadow: 0 8px 24px -6px rgba(201, 162, 39, 0.45);
  }

  .btn--primary:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
  }

  .btn--secondary {
    background: rgba(255, 255, 255, 0.06);
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.24);
  }

  .hc--white .btn--secondary,
  .hc--gray .btn--secondary {
    background: var(--surface);
    border-color: var(--line-strong);
    color: var(--fg);
  }

  .btn--secondary:hover {
    border-color: var(--gold);
  }

  .btn--link {
    background: transparent;
    border: 1px solid transparent;
    color: var(--gold);
    padding-inline: 14px;
    font-weight: 600;
  }

  .hc--white .btn--link,
  .hc--gray .btn--link {
    color: var(--gold-ink);
  }

  .hc__arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .btn--link:hover .hc__arrow {
    transform: translateX(4px);
  }

  .hc__metrics {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1.1rem 1.5rem;
    border-radius: 14px;
    background: rgba(8, 17, 34, 0.58);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 680px;
  }

  .hc__metrics li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .hc__metrics strong {
    font-family: var(--f-display);
    font-size: 1.25rem;
    color: var(--gold);
    line-height: 1.1;
  }

  .hc__metrics span {
    font-size: 0.76rem;
    color: var(--on-navy-muted);
  }

  .hc__media {
    max-width: 1040px;
    margin: clamp(2.25rem, 5vw, 3.5rem) auto 0;
  }

  .hc--compact .hc__media {
    max-width: 920px;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .hc__media-window {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(201, 162, 39, 0.32);
    background: #071021;
    box-shadow: 0 40px 80px -36px rgba(4, 9, 20, 0.65);
  }

  .hc__window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(12, 25, 49, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--f-code);
    font-size: 0.68rem;
    color: var(--on-navy-muted);
  }

  .hc__window-dots {
    display: flex;
    gap: 6px;
  }

  .hc__window-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .hc__window-dots span:first-child {
    background: rgba(201, 162, 39, 0.75);
  }

  .hc__window-title {
    letter-spacing: 0.06em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hc__window-status {
    color: var(--gold);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .hc__window-status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px #34d399;
  }

  .hc__media-frame :global(.brand-image) {
    width: 100%;
    aspect-ratio: 21 / 9;
    border-radius: 0;
    border: 0;
    box-shadow: none;
  }

  .hc--compact .hc__media-frame :global(.brand-image) {
    aspect-ratio: 24 / 8;
  }

  .hc__media-frame img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  /* light entrance animation — staggered */
  @keyframes hcRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hcMedia {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hc__anim {
    opacity: 0;
    animation: hcRise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  .hc__media.hc__anim {
    animation-name: hcMedia;
  }

  @media (prefers-reduced-motion: reduce) {
    .hc__anim {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }

  @media (max-width: 680px) {
    .hc__actions {
      width: 100%;
    }
    .hc__actions .btn {
      flex: 1 1 auto;
    }
    .hc__actions .btn--link {
      flex-basis: 100%;
    }
    .hc__metrics {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 0.9rem 1rem;
    }
    .hc__window-title {
      display: none;
    }
    .hc__media-frame :global(.brand-image),
    .hc--compact .hc__media-frame :global(.brand-image) {
      aspect-ratio: 16 / 9;
    }
  }
</style>


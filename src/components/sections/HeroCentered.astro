---
// HeroCentered — High-contrast executive hero.
// Home uses GridScan (intro animation only, static camera, no mouse reaction); subpages use zero-JS static architectural grid.
import '../interactive/GridScan.css';
import type { BrandImageKind } from '../../data/brand-images';
import type { Locale } from '../../data/site';

interface Cta {
  label: string;
  href: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface MetricItem {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primary?: Cta;
  secondary?: Cta;
  link?: Cta;
  image?: string;
  imageAlt?: string;
  imageKind?: BrandImageKind;
  locale?: Locale;
  bg?: 'white' | 'gray' | 'navy';
  bgEffect?: 'grid-scan' | 'static';
  breadcrumbs?: BreadcrumbItem[];
  metrics?: MetricItem[];
  showMedia?: boolean;
  compact?: boolean;
}

const {
  title,
  subtitle,
  primary,
  secondary,
  link,
  locale = 'es',
  bg = 'navy',
  bgEffect = 'static',
  breadcrumbs = [],
  metrics = [],
  compact = false,
} = Astro.props;
---

<section
  data-ab-category="Hero"
  class:list={[
    'hc',
    `hc--${bg}`,
    compact && 'hc--compact',
    bg === 'navy' && 'hc--static-grid',
  ]}
>
  {
    bg === 'navy' && bgEffect === 'grid-scan' && (
      <div class="grid-scan hc__bg-canvas" data-grid-scan>
        <canvas class="grid-scan-canvas" aria-hidden="true" />
      </div>
    )
  }

  <div class="hc__scrim" aria-hidden="true"></div>

  <div class="wrap hc__container">
    <div class="hc__inner">
      {
        breadcrumbs.length > 0 && (
          <nav
            class="breadcrumbs hc__anim"
            style="--d:0ms"
            aria-label={locale === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
          >
            {breadcrumbs.map((crumb, idx) => (
              <>
                {idx > 0 && <span aria-hidden="true">/</span>}
                {crumb.href ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }

      <h1 class="hc__title hc__anim" style="--d:60ms">{title}</h1>

      {
        subtitle && (
          <p class="hc__subtitle hc__anim" style="--d:120ms">
            {subtitle}
          </p>
        )
      }

      {
        (primary || secondary || link) && (
          <div class="hc__actions hc__anim" style="--d:180ms">
            {primary && (
              <a class="btn btn--primary" href={primary.href}>
                {primary.label}
              </a>
            )}
            {secondary && (
              <a class="btn btn--secondary" href={secondary.href}>
                {secondary.label}
              </a>
            )}
            {link && (
              <a class="btn btn--link" href={link.href}>
                <span>{link.label}</span>
                <span class="hc__arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )
      }

      {
        metrics.length > 0 && (
          <ul
            class="hc__metrics hc__anim"
            style="--d:240ms"
            aria-label={locale === 'es' ? 'Indicadores clave' : 'Key indicators'}
          >
            {metrics.map((m) => (
              <li>
                <strong>{m.value}</strong>
                <span>{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

<style>
  .hc {
    position: relative;
    overflow: hidden;
    padding: clamp(4.25rem, 8.5vw, 7rem) 0 clamp(3.75rem, 7vw, 5.75rem);
    border-bottom: 1px solid var(--line);
  }

  .hc--compact {
    padding: clamp(3rem, 5.5vw, 4.5rem) 0 clamp(2.5rem, 4.5vw, 3.75rem);
  }

  .hc--white {
    background: var(--surface);
    color: var(--fg);
  }

  .hc--gray {
    background: var(--bg);
    color: var(--fg);
  }

  .hc--navy {
    background: #050b16;
    color: var(--on-navy);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .hc--static-grid {
    background-color: #060d1b;
    background-image:
      radial-gradient(ellipse 65% 55% at 50% 0%, rgba(29, 78, 216, 0.22), transparent 65%),
      radial-gradient(ellipse 45% 40% at 80% 100%, rgba(201, 162, 39, 0.1), transparent 60%),
      linear-gradient(to right, rgba(30, 58, 138, 0.18) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(30, 58, 138, 0.18) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 44px 44px, 44px 44px;
  }

  .hc :global(astro-island) {
    display: contents;
  }

  .hc :global(.hc__bg-canvas) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* High-contrast protective vignette behind headline & subtitle */
  .hc__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 68% 65% at 50% 46%,
      rgba(5, 11, 22, 0.86) 0%,
      rgba(5, 11, 22, 0.62) 52%,
      rgba(5, 11, 22, 0.25) 100%
    );
  }

  .hc__container {
    position: relative;
    z-index: 2;
  }

  .hc__inner {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hc__title {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(2.7rem, 5.4vw, 4.35rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.022em;
    text-wrap: balance;
    text-shadow: 0 4px 28px rgba(3, 7, 16, 0.95);
  }

  .hc--compact .hc__title {
    margin-top: 0.65rem;
    font-size: clamp(2.15rem, 4vw, 3.25rem);
  }

  .hc--navy .hc__title {
    color: #ffffff;
  }

  .hc__subtitle {
    margin: 1.25rem 0 0;
    max-width: 56ch;
    font-size: clamp(1.12rem, 1.45vw, 1.28rem);
    font-weight: 450;
    line-height: 1.58;
    color: rgba(33, 32, 28, 0.85);
    text-shadow: 0 2px 18px rgba(3, 7, 16, 0.95);
  }

  .hc--navy .hc__subtitle {
    color: #eef3fb;
  }

  .hc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2.15rem;
  }

  .btn--primary {
    background: var(--gold);
    color: #161209;
    border: 1px solid var(--gold);
    font-weight: 600;
    padding: 0.78rem 1.45rem;
    font-size: 0.96rem;
    box-shadow: 0 10px 28px -6px rgba(201, 162, 39, 0.55);
    transition: background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .btn--primary:hover {
    background: var(--gold-hover);
    border-color: var(--gold-hover);
    transform: translateY(-1px);
  }

  /* Royal Blue Secondary Button */
  .btn--secondary {
    background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    border: 1px solid #3b82f6;
    font-weight: 600;
    padding: 0.78rem 1.45rem;
    font-size: 0.96rem;
    box-shadow: 0 10px 28px -6px rgba(37, 99, 235, 0.55);
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .btn--secondary:hover {
    background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
    border-color: #60a5fa;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 12px 32px -6px rgba(59, 130, 246, 0.65);
  }

  .btn--link {
    background: transparent;
    border: 1px solid transparent;
    color: var(--gold);
    padding-inline: 14px;
    font-weight: 600;
  }

  .hc--white .btn--link,
  .hc--gray .btn--link {
    color: var(--gold-ink);
  }

  .hc__arrow {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .btn--link:hover .hc__arrow {
    transform: translateX(4px);
  }

  .hc__metrics {
    list-style: none;
    margin: 2.35rem 0 0;
    padding: 1.15rem 1.6rem;
    border-radius: 14px;
    background: rgba(8, 17, 34, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 16px 36px rgba(3, 8, 18, 0.45);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
    max-width: 680px;
  }

  .hc__metrics li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .hc__metrics strong {
    font-family: var(--f-display);
    font-size: 1.32rem;
    color: var(--gold);
    line-height: 1.1;
  }

  .hc__metrics span {
    font-size: 0.78rem;
    color: #cbd5e1;
  }

  .hc__anim {
    opacity: 1;
    transform: none;
    animation: none;
  }

  @media (max-width: 680px) {
    .hc__actions {
      width: 100%;
    }
    .hc__actions .btn {
      flex: 1 1 auto;
    }
    .hc__actions .btn--link {
      flex-basis: 100%;
    }
    .hc__metrics {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      padding: 0.9rem 1rem;
    }
  }
</style>

<script>
  import '../interactive/grid-scan-vanilla';
</script>


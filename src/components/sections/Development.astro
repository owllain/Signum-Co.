---
import type { SiteContent } from '../../data/site';
import { developmentServices } from '../../data/services';
import { routes } from '../../data/experience';
import ServiceIcon from '../ui/ServiceIcon.astro';
import BrandImage from '../ui/BrandImage.astro';
import Arrow from '../ui/Arrow.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const es = content.locale === 'es';
---

<section class="sec" id="capacidades" aria-labelledby="development-title">
  <div class="wrap">
    <div class="section-heading">
      <div>
        <span class="section-label">
          {es ? 'Ingeniería de software y automatización' : 'Software engineering & automation'}
        </span>
        <h2 id="development-title">
          {es ? 'Tecnología que trabaja con su equipo.' : 'Technology that works with your team.'}
        </h2>
      </div>
      <p class="intro">
        {
          es
            ? 'Responsable: Enrique Cascante · Desarrollo de aplicaciones empresariales, flujos de aprobación e integraciones.'
            : 'Lead: Enrique Cascante · Business application development, approval workflows and integrations.'
        }
      </p>
    </div>

    <div class="dev-bento-grid">
      {
        developmentServices[content.locale].map((service, idx) => (
          <article class="bento-service-card dev-card-modern" id={service.id}>
            <div class="bento-card-thumb">
              <BrandImage
                kind={service.image}
                locale={content.locale}
                alt=""
                showBadge
                sizes="(max-width: 760px) 100vw, 480px"
              />
            </div>
            <div class="bento-card-body">
              <div class="bento-card-meta">
                <span class="bento-code">E-0{idx + 1}</span>
                <span class="bento-tech-tag">{service.tag}</span>
              </div>
              <div class="dev-card-title-row">
                <ServiceIcon kind={service.icon} />
                <h3>{service.title}</h3>
              </div>
              <p class="bento-desc">{service.description}</p>
              <ul class="bento-deliverables">
                {service.deliverables.map((item) => (
                  <li>
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                    >
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="bento-card-footer">
                <span class="bento-owner">Enrique Cascante</span>
                <a
                  class="bento-cta"
                  data-contact-topic={service.id}
                  href={`${routes[content.locale].contact}?topic=${service.id}#contacto`}
                >
                  <span>{es ? 'Hablemos de su proyecto' : 'Discuss your project'}</span>
                  <Arrow />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="sec sec-alt" id="alcance" aria-labelledby="scope-title">
  <div class="wrap scope-grid">
    <div>
      <span class="section-label">{es ? 'Un alcance claro' : 'A clear scope'}</span>
      <h2 id="scope-title">
        {
          es
            ? 'Empezamos por un proceso. Construimos con criterio.'
            : 'Start with one process. Build with purpose.'
        }
      </h2>
    </div>
    <div class="scope-cards-col">
      <div class="scope-box">
        <strong>{es ? 'Arquitectura adaptada a su entorno' : 'Architecture tailored to your stack'}</strong>
        <p>
          {
            es
              ? 'Definimos accesos, licencias, datos de prueba y criterios de aceptación antes de construir. Las tecnologías se eligen según su entorno: .NET, React, SQL, Microsoft 365, SharePoint y Power Platform.'
              : 'We define access, licensing, test data and acceptance criteria before building. Technologies follow your environment: .NET, React, SQL, Microsoft 365, SharePoint and Power Platform.'
          }
        </p>
      </div>
      <div class="scope-box">
        <strong>{es ? 'Evidencia técnica y trazabilidad' : 'Technical evidence & traceability'}</strong>
        <p>
          {
            es
              ? 'La revisión técnica documenta funcionamiento, controles y trazabilidad dentro de un alcance acordado. No incluye certificación ISO, auditoría financiera ni peritaje judicial. Cuando revisamos una solución propia, lo presentamos como validación interna.'
              : 'Technical reviews document functionality, controls and traceability within an agreed scope. They do not include ISO certification, financial auditing or judicial expert reports. Reviews of our own solutions are described as internal validation.'
          }
        </p>
      </div>
    </div>
  </div>
</section>

---
import { experience, contactTopics } from '../../data/experience';
import {
  SITE_CONFIG,
  buildMailtoUrl,
  buildWhatsappUrl,
  type SiteContent,
} from '../../data/site';
import BrandImage from '../ui/BrandImage.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const es = content.locale === 'es';
const text = experience[content.locale];
const topics = contactTopics(content);
const quickPills = [
  { id: 'enterprise-1', label: es ? 'Ingeniería de datos' : 'Data engineering' },
  { id: 'enterprise-2', label: es ? 'Tableros ejecutivos' : 'Executive dashboards' },
  { id: 'automation', label: es ? 'Automatización' : 'Automation' },
  { id: 'applications', label: es ? 'Aplicaciones' : 'Applications' },
  { id: 'integrations', label: es ? 'Integraciones' : 'Integrations' },
  { id: 'service-0', label: es ? 'Medición GA4 / GTM' : 'GA4 / GTM Tracking' },
];
const defaultMessage = content.contact.form.msgGreeting;
const defaultWhatsappHref = buildWhatsappUrl(defaultMessage);
const defaultMailHref = buildMailtoUrl(
  content.contact.form.mailSubjectBase,
  defaultMessage
);
---

<section class="contact" id={content.contact.id} aria-labelledby="h-c">
  <div class="wrap">
    <div class="contact-info-col">
      <div class="contact-sig-banner">
        <div class="contact-sig-avatar">
          <BrandImage
            kind="sig"
            locale={content.locale}
            alt={es ? 'Sig, insignia de Signum & Co., señala el inicio de la conversación' : 'Sig, Signum & Co. emblem, points to the start of the conversation'}
            sizes="96px"
          />
        </div>
        <div>
          <span class="section-label">
            {es ? 'Hablemos de su objetivo' : 'Let’s discuss your goal'}
          </span>
          <h2 id="h-c">{text.nextTitle}</h2>
        </div>
      </div>

      <p class="intro">{content.contact.intro}</p>
      <ol class="contact-next">
        {text.nextSteps.map((step) => <li>{step}</li>)}
      </ol>
      <dl class="direct">
        <div>
          <dt>{content.contact.whatsappLabel}</dt>
          <dd>
            <a
              class="sel"
              href={defaultWhatsappHref}
              target="_blank"
              rel="noopener noreferrer"
            >
              {SITE_CONFIG.contact.phoneDisplay}
            </a>
            <button
              class="copy"
              type="button"
              data-copy={SITE_CONFIG.contact.phoneDisplay}
              data-copied-label={content.contact.copiedButton}
            >
              {content.contact.copyButton}
            </button>
          </dd>
        </div>
        <div>
          <dt>{content.contact.emailLabel}</dt>
          <dd>
            <a class="sel" href={`mailto:${SITE_CONFIG.contact.email}`}>
              {SITE_CONFIG.contact.email}
            </a>
            <button
              class="copy"
              type="button"
              data-copy={SITE_CONFIG.contact.email}
              data-copied-label={content.contact.copiedButton}
            >
              {content.contact.copyButton}
            </button>
          </dd>
        </div>
      </dl>
    </div>

    <form
      class="cform"
      id="cform"
      novalidate
      data-topic-prefix={text.interestsLabel}
      data-greeting={content.contact.form.msgGreeting}
      data-name-prefix={content.contact.form.msgNamePrefix}
      data-biz-prefix={content.contact.form.msgBizPrefix}
      data-web-prefix={content.contact.form.msgWebPrefix}
      data-need-prefix={content.contact.form.msgNeedPrefix}
      data-subject-base={content.contact.form.mailSubjectBase}
      data-wa-base={SITE_CONFIG.contact.whatsappBaseUrl}
      data-email={SITE_CONFIG.contact.email}
    >
      <div class="field">
        <span class="quick-topic-label">
          {es ? 'Selección rápida de necesidad' : 'Quick topic selection'}
        </span>
        <div class="quick-topic-pills">
          {
            quickPills.map((pill) => (
              <button
                type="button"
                class="quick-topic-pill"
                data-quick-topic={pill.id}
                aria-pressed="false"
              >
                {pill.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="field">
        <label for="c-topic">{text.interestsLabel}</label>
        <select id="c-topic" name="topic">
          <option value="">{text.interestsPlaceholder}</option>
          {
            topics.map((topic) => (
              <option value={topic.id}>{topic.label}</option>
            ))
          }
        </select>
      </div>

      <div class="field-row-2">
        <div class="field">
          <label for="c-name">{content.contact.form.nameLabel}</label>
          <input id="c-name" name="name" type="text" autocomplete="name" />
        </div>

        <div class="field">
          <label for="c-biz">{content.contact.form.bizLabel}</label>
          <input
            id="c-biz"
            name="biz"
            type="text"
            autocomplete="organization"
          />
        </div>
      </div>

      <div class="field">
        <label for="c-web">{content.contact.form.webLabel}</label>
        <input
          id="c-web"
          name="web"
          type="text"
          inputmode="url"
          placeholder={content.contact.form.webPlaceholder}
        />
      </div>

      <div class="field">
        <label for="c-need">
          {content.contact.form.needLabel}{' '}
          <small>{content.contact.form.optionalLabel}</small>
        </label>
        <textarea id="c-need" name="need" rows="3"></textarea>
      </div>

      <div class="field">
        <span class="preview-label" id="preview-label">
          {content.contact.form.previewLabel}
        </span>
        <div
          class="preview"
          id="preview"
          role="region"
          aria-labelledby="preview-label"
          aria-live="polite"
        >{defaultMessage}</div>
      </div>

      <div class="send">
        <a
          class="btn btn-gold"
          id="wa-contact"
          href={defaultWhatsappHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="currentColor"
          >
            <path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.2.5.1.6-.1l.9-1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"
            ></path>
          </svg>
          <span>{content.contact.form.sendWhatsapp}</span>
        </a>

        <a class="btn btn-line" id="mail-contact" href={defaultMailHref}>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          <span>{content.contact.form.sendEmail}</span>
        </a>
      </div>

      <p class="hint">{content.contact.form.hint}</p>
      <noscript>
        <p class="hint">
          {
            es
              ? 'Sin JavaScript, use los enlaces directos y escriba su consulta en WhatsApp o correo. Los campos no se adjuntan automáticamente.'
              : 'Without JavaScript, use the direct links and write your enquiry in WhatsApp or email. Form fields are not attached automatically.'
          }
        </p>
      </noscript>
    </form>
  </div>
</section>

<script>
  import '../../scripts/contact.ts';
</script>

---
import { BRAND_IMAGES, type BrandImageKind } from '../../data/brand-images';
import type { Locale } from '../../data/site';

interface Props {
  kind: BrandImageKind;
  locale?: Locale;
  eager?: boolean;
  alt?: string;
  sizes?: string;
  showBadge?: boolean;
  class?: string;
}

const {
  kind,
  locale = 'es',
  eager = false,
  alt,
  sizes,
  showBadge = false,
  class: className = '',
} = Astro.props;

const meta = BRAND_IMAGES[kind];
const resolvedAlt = alt !== undefined ? alt : meta.alt[locale];
const resolvedSizes =
  sizes ??
  (kind === 'sig'
    ? '(max-width: 760px) 96px, 128px'
    : '(max-width: 760px) 100vw, (max-width: 1120px) 48vw, 540px');
---

<div
  class:list={[
    'brand-image',
    { 'brand-image-transparent': meta.transparent },
    className,
  ]}
  style={`--img-aspect: ${meta.aspectRatio}; --img-lqip: url("${meta.lqip}");`}
  data-image-shell
>
  <div class="brand-image-skeleton" aria-hidden="true"></div>
  <img
    src={meta.src}
    srcset={meta.srcset}
    sizes={resolvedSizes}
    width={meta.width}
    height={meta.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding={eager ? 'sync' : 'async'}
    alt={resolvedAlt}
  />
  {
    showBadge && !meta.transparent && (
      <span class="brand-image-badge" aria-hidden="true">
        <i class="brand-image-dot" />
        {meta.tag[locale]}
      </span>
    )
  }
</div>

<script>
  function hydrateBrandImages() {
    document.querySelectorAll<HTMLElement>('[data-image-shell]').forEach((shell) => {
      if (shell.dataset.loaded === 'true' || shell.dataset.bound === 'true') {
        const img = shell.querySelector('img');
        if (img?.complete && img.naturalWidth > 0) {
          shell.dataset.loaded = 'true';
        }
        return;
      }
      shell.dataset.bound = 'true';
      const image = shell.querySelector('img');
      if (!image) {
        shell.dataset.loaded = 'true';
        return;
      }
      const markLoaded = () => {
        shell.dataset.loaded = 'true';
      };
      const markError = () => {
        shell.dataset.loaded = 'error';
      };
      if (image.complete) {
        if (image.naturalWidth > 0) markLoaded();
        else markError();
      } else {
        image.addEventListener('load', markLoaded, { once: true });
        image.addEventListener('error', markError, { once: true });
      }
    });
  }

  hydrateBrandImages();
  document.addEventListener('astro:page-load', hydrateBrandImages);
</script>

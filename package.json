{
  "name": "signum-and-co",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web corporativo bilingüe de Signum & Co. (Consultora de datos, marketing, tecnología e IA en Costa Rica)",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "node ./node_modules/astro/astro.js dev",
    "start": "node ./node_modules/astro/astro.js dev",
    "build": "node ./node_modules/astro/astro.js check && node ./node_modules/astro/astro.js build",
    "preview": "node ./node_modules/astro/astro.js preview",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "node ./node_modules/astro/astro.js check",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/libre-caslon-text": "^5.2.5",
    "@fontsource/schibsted-grotesk": "^5.2.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  }
}

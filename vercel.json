{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/es/consultora/",
      "destination": "/es/nosotros/",
      "permanent": true
    },
    {
      "source": "/es/empresas/",
      "destination": "/es/datos/",
      "permanent": true
    },
    {
      "source": "/en/enterprise/",
      "destination": "/en/data-analytics/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
